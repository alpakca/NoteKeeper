#define Path ShellFolderPath = "C:\Users\user\Desktop\C#\NoteKeeper\NoteKeeper\Assets\Shell\";

#define SelectablePacket selectablePacket { }
#define HoldablePacket holdablePacket { }

VisualToggleButton Writing_Mode_Toggle 
{
	Name = "WritingMode",
	Boundaries = Rectangle(100, 60, 32, 32),
	UncheckedAnimation = Animation(ShellFolderPath + "WritingMode.png"),
	CheckedAnimation = Animation(ShellFolderPath + "WritingModeSelected.png"),

	SelectablePacket = selectablePacket,
	HoldablePacket = holdablePacket
}

VisualToggleButton Transform_Mode_Toggle
{
	Name = "TransformMode",
	Boundaries = Rectangle(130, 60, 32, 32),
	UncheckedAnimation = Animation(ShellFolderPath + "TransformMode.png"),
	CheckedAnimation = Animation(ShellFolderPath + "TransformModeSelected.png"),

	SelectablePacket = selectablePacket,
	HoldablePacket = holdablePacket
}

VisualClickable Add_Text_Block
{
	Name = "AddTextBlock",
	Boundaries = Rectangle(160, 60, 32, 32),
	DefaultAnimation = Animation(ShellFolderPath + "AddTextBlock.png"),
	HoverAnimation = Animation(ShellFolderPath + "AddTextBlockHovered.png"),
	HoldAnimation = Animation(ShellFolderPath + "AddTextBlockHeld.png"),

	SelectablePacket = selectablePacket,
	HoldablePacket = holdablePacket
}